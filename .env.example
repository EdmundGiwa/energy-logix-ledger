# Local Docker development only. Replace every secret outside local development.
POSTGRES_DB=petroledger
POSTGRES_USER=petroledger
POSTGRES_PASSWORD=petroledger
POSTGRES_APP_USER=petroledger_app
POSTGRES_APP_PASSWORD=petroledger_app
DJANGO_SECRET_KEY=insecure-local-development-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8001
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
