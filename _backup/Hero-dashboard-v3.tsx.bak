/* ------------------------------------------------------------------ */
/* Small building blocks                                               */
/* ------------------------------------------------------------------ */

const toneText: Record<Tone, string> = {
  ok: "text-emerald-300",
  warn: "text-amber-300",
  crit: "text-red-300",
  info: "text-sky-300",
};
const toneBg: Record<Tone, string> = {
  ok: "bg-ok/20 text-emerald-200",
  warn: "bg-amber/20 text-amber-200",
  crit: "bg-crit/25 text-red-200",
  info: "bg-sky/20 text-sky-200",
};
const toneBar: Record<Tone, string> = {
  ok: "from-emerald-400 to-ok",
  warn: "from-gold to-amber",
  crit: "from-red-400 to-crit",
  info: "from-sky to-azure",
};

function Chip({ children, className = "" }: { children: ReactNode; className?: string }) {
  return (
    <div className={`glass flex h-11 shrink-0 items-center gap-2 rounded-2xl px-3.5 text-[12.5px] font-medium text-white/90 ${className}`}>
      {children}
    </div>
  );
}

function CardHeader({ title, href = "#modules" }: { title: string; href?: string }) {
  return (
    <div className="flex items-center justify-between">
      <p className="text-[17px] font-bold tracking-tight text-white">{title}</p>
      <a
        href={href}
        aria-label={`Open ${title}`}
        className="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-white ring-1 ring-white/15 transition hover:bg-white/20"
      >
        <Icon.ArrowUpRight size={18} />
      </a>
    </div>
  );
}

function Spark({ data, color, id }: { data: number[]; color: string; id: string }) {
  const w = 160;
  const h = 44;
  const step = w / (data.length - 1);
  const pts = data.map((v, i) => [i * step, h - v * (h - 6) - 3] as const);
  // Smooth with simple quadratic midpoints
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const mx = (x0 + x1) / 2;
    d += ` Q${x0.toFixed(1)},${y0.toFixed(1)} ${mx.toFixed(1)},${((y0 + y1) / 2).toFixed(1)}`;
  }
  d += ` T${pts[pts.length - 1][0]},${pts[pts.length - 1][1]}`;
  return (
    <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" className="h-full w-full overflow-visible" aria-hidden>
      <defs>
        <linearGradient id={`hs-${id}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor={color} stopOpacity="0.4" />
          <stop offset="1" stopColor={color} stopOpacity="0" />
        </linearGradient>
      </defs>
      <path d={`${d} L${w},${h} L0,${h} Z`} fill={`url(#hs-${id})`} className="fade-in" style={{ animationDelay: "0.6s" }} />
      <path
        d={d}
        pathLength={1}
        fill="none"
        stroke={color}
        strokeWidth="2"
        vectorEffect="non-scaling-stroke"
        className="draw-line"
      />
    </svg>
  );
}

function MiniBars({ seed }: { seed: number }) {
  const data = useMemo(() => seeded(12, seed, 0.25, 1), [seed]);
  const peak = data.indexOf(Math.max(...data));
  return (
    <div className="flex h-10 items-end gap-[5px]">
      {data.map((v, i) => (
        <span
          key={i}
          className={`bar-anim w-full rounded-full ${i === peak ? "bg-gold" : "bg-gold/55"}`}
          style={{ height: `${v * 100}%`, animationDelay: `${0.25 + i * 0.045}s` }}
        />
      ))}
    </div>
  );
}

function ProgressPill({ pct }: { pct: number }) {
  return (
    <div className="relative mt-3 flex h-9 items-center rounded-full bg-black/25 p-1 ring-1 ring-white/10">
      <div
        className="bar-anim-x relative h-full rounded-full bg-gradient-to-r from-amber to-gold shadow-[0_0_24px_-4px_rgba(251,191,36,0.9)]"
        style={{ width: `${Math.max(18, pct * 62)}%`, animationDelay: "0.3s" }}
      >
        <span className="absolute right-2 top-1/2 h-3.5 w-1 -translate-y-1/2 rounded-full bg-white/90" />
      </div>
      <div className="flex flex-1 justify-evenly">
        {[0, 1, 2, 3].map((i) => (
          <span key={i} className="h-1 w-1 rounded-full bg-white/30" />
        ))}
      </div>
    </div>
  );
}

function TileCard({ tile, sceneKey, index }: { tile: Tile; sceneKey: string; index: number }) {
  const I = tile.icon;
  return (
    <div className="glass-tile rise relative overflow-hidden rounded-[20px] p-3.5" style={{ animationDelay: `${0.08 * index}s` }}>
      <div className="flex items-start justify-between gap-2">
        <p className="text-[12.5px] font-medium leading-tight text-white/80">{tile.label}</p>
        <span className="grid h-6 w-6 shrink-0 place-items-center rounded-lg bg-white/90 text-navy">
          <I size={13} />
        </span>
      </div>

      {tile.kind === "spark" && (
        <>
          <p className={`mt-1 text-[10.5px] font-semibold ${toneText[tile.tone]}`}>{tile.note}</p>
          <p className="mt-1.5 text-[26px] font-extrabold leading-none tracking-tight text-white">
            <CountUp key={sceneKey} to={tile.value} decimals={tile.decimals ?? 0} prefix={tile.prefix} />
            {tile.unit && <span className="ml-1 text-[12px] font-semibold text-white/45">{tile.unit}</span>}
          </p>
          <div className="-mx-3.5 -mb-3.5 mt-2 h-12">
            <Spark id={`${sceneKey}-${index}`} data={seeded(16, tile.seed, 0.15, 0.95)} color={tile.color ?? "#fbbf24"} />
          </div>
        </>
      )}

      {tile.kind === "progress" && (
        <>
          <p className="mt-3 text-[26px] font-extrabold leading-none tracking-tight text-white">{tile.display}</p>
          <p className="mt-1.5 truncate text-[11.5px] text-white/50">{tile.note}</p>
          <ProgressPill pct={tile.pct} />
        </>
      )}

      {tile.kind === "bars" && (
        <>
          <p className="mt-3 text-[26px] font-extrabold leading-none tracking-tight text-white">{tile.display}</p>
          <p className="mt-1.5 truncate text-[11.5px] text-white/50">{tile.note}</p>
          <div className="mt-3">
            <MiniBars seed={tile.seed} />
          </div>
        </>
      )}
    </div>
  );
}

