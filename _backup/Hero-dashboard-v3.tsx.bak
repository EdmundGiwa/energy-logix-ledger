    <svg viewBox="0 0 260 200" className="h-full w-full" aria-hidden>
      {kind === "bunker" && (
        <g {...common}>
          <ellipse cx="80" cy="60" rx="52" ry="14" />
          <path d="M28 60v86c0 8 23 14 52 14s52-6 52-14V60" />
