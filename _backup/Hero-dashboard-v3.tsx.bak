  { id: "Lagos", x: 52, y: 92, label: "Lagos Anchorage", tone: "ok" as Tone },
  { id: "Lekki", x: 104, y: 97, label: "Lekki gantry", tone: "warn" as Tone, below: true },
  { id: "Warri", x: 222, y: 92, label: "Warri", tone: "ok" as Tone },
  { id: "Escravos", x: 196, y: 128, label: "Escravos", tone: "ok" as Tone },
  { id: "PH", x: 326, y: 112, label: "Port Harcourt", tone: "ok" as Tone },
  { id: "Onne", x: 344, y: 138, label: "Onne", tone: "ok" as Tone },
  { id: "Bonny", x: 318, y: 160, label: "Bonny", tone: "crit" as Tone },
];
const siteColor: Record<Tone, string> = { ok: "#fbbf24", warn: "#f59e0b", crit: "#ef4444", info: "#38bdf8" };

function CoastMap({ active }: { active: string }) {
  const coast =
    "M0,104 C30,100 50,100 80,104 C120,108 150,110 176,116 C192,120 198,134 206,148 C214,162 232,172 256,176 C276,180 292,178 306,172 C318,168 330,164 346,156 C366,146 384,140 400,138";
  return (
    <svg viewBox="0 0 400 220" className="h-full w-full" aria-label="Operations map of the Nigerian coast">
      <defs>
        <linearGradient id="land" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor="#f59e0b" stopOpacity="0.55" />
          <stop offset="1" stopColor="#d97706" stopOpacity="0.85" />
        </linearGradient>
        <pattern id="landDots" width="6" height="6" patternUnits="userSpaceOnUse">
          <circle cx="3" cy="3" r="1.1" fill="rgba(255,255,255,0.35)" />
        </pattern>
        <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor="#0284c7" stopOpacity="0.35" />
          <stop offset="1" stopColor="#0b1f33" stopOpacity="0.2" />
        </linearGradient>
        <radialGradient id="siteGlow">
          <stop offset="0" stopColor="#fbbf24" stopOpacity="0.8" />
          <stop offset="1" stopColor="#fbbf24" stopOpacity="0" />
        </radialGradient>
      </defs>
      <path d={`${coast} L400,220 L0,220 Z`} fill="url(#sea)" />
      {/* Land */}
      <path d={`${coast} L400,0 L0,0 Z`} fill="url(#land)" opacity="0.75" />
      <path d={`${coast} L400,0 L0,0 Z`} fill="url(#landDots)" opacity="0.5" />
      {/* Niger delta creeks */}
      <g stroke="rgba(6,17,29,0.35)" strokeWidth="1.2" fill="none">
        <path d="M230,60 C226,90 214,110 206,146" />
        <path d="M236,70 C246,110 252,140 256,172" />
        <path d="M240,80 C268,110 288,140 300,170" />
      </g>
      {/* Coastline */}
      <path d={coast} fill="none" stroke="rgba(255,255,255,0.7)" strokeWidth="1.4" />
      {/* Sea texture */}
      {[0, 1, 2].map((i) => (
        <path
          key={i}
          d={coast}
          fill="none"
          stroke="rgba(255,255,255,0.08)"
          strokeWidth="1"
          transform={`translate(0 ${14 + i * 12})`}
        />
      ))}
      {/* Routes */}
      <path d="M52,92 C70,96 84,96 100,96" stroke="#fbbf24" strokeWidth="2" strokeDasharray="4 4" fill="none" className="animate-dash" />
      <path d="M52,118 C140,150 230,200 318,174" stroke="rgba(255,255,255,0.6)" strokeWidth="1.2" strokeDasharray="2 5" fill="none" className="animate-dash" />
      <path d="M196,128 C206,112 214,100 222,92" stroke="#38bdf8" strokeWidth="2" fill="none" />
      <path d="M326,112 L344,138 L318,160" stroke="#38bdf8" strokeWidth="1.6" fill="none" opacity="0.8" />
      {/* Sites */}
      {sites.map((s) => {
        const on = s.id === active;
        return (
          <g key={s.id}>
            {on && <circle cx={s.x} cy={s.y} r="22" fill="url(#siteGlow)" className="animate-glow" />}
            <circle cx={s.x} cy={s.y} r={on ? 6 : 4} fill="#0b1f33" stroke={siteColor[s.tone]} strokeWidth="2.2" />
            {on && <circle cx={s.x} cy={s.y} r="2" fill={siteColor[s.tone]} />}
            {(on || s.tone !== "ok") && (
              <g className="fade-in" transform={s.below ? "translate(-6 30)" : undefined}>
                <rect x={s.x + 8} y={s.y - 19} width={s.label.length * 5.4 + 12} height="16" rx="8" fill="rgba(6,17,29,0.8)" />
                <text x={s.x + 14} y={s.y - 8} fontSize="9" fontWeight="700" fill="#fff" fontFamily="var(--font-manrope)">
                  {s.label}
                </text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  );
}

function TrendBars({ seed, tab }: { seed: number; tab: number }) {
  const actual = useMemo(() => seeded(10, seed + tab * 7, 0.3, 0.85), [seed, tab]);
  const plan = useMemo(() => seeded(10, seed + 100 + tab * 3, 0.55, 1), [seed, tab]);
  return (
    <div className="flex h-full items-end gap-2 sm:gap-2.5">
      {actual.map((v, i) => (
        <div key={`${seed}-${tab}-${i}`} className="relative flex h-full flex-1 items-end">
          <span
            className="bar-anim absolute inset-x-0 bottom-0 rounded-full bg-gold/25"
            style={{ height: `${Math.max(v, plan[i]) * 100}%`, animationDelay: `${i * 0.05}s` }}
          />
          <span
            className="bar-anim relative w-full rounded-full bg-gradient-to-t from-amber to-gold shadow-[0_0_20px_-6px_rgba(251,191,36,0.9)]"
            style={{ height: `${v * 100}%`, animationDelay: `${0.15 + i * 0.05}s` }}
          />
        </div>
      ))}
    </div>
  );
}

const bubbles = [
  { label: "NCFCC", x: 34, y: 42, r: 15.1, c: "gold" },
  { label: "NUPRC", x: 60, y: 35, r: 12.2, c: "azure" },
  { label: "NIMASA", x: 82, y: 52, r: 10.8, c: "azure" },
  { label: "ISO 45001", x: 50, y: 70, r: 10.1, c: "gold" },
  { label: "NCEC", x: 16, y: 64, r: 7.2, c: "azure" },
  { label: "NMDPRA", x: 73, y: 76, r: 7.9, c: "gold" },
  { label: "", x: 13, y: 33, r: 2.9, c: "azure" },
  { label: "", x: 92, y: 26, r: 3.6, c: "gold" },
  { label: "NPA", x: 31, y: 84, r: 5.4, c: "azure" },
  { label: "", x: 90, y: 82, r: 3.2, c: "gold" },
  { label: "", x: 44, y: 18, r: 2.5, c: "gold" },
];

function RenewalBubbles() {
  return (
    <div className="relative h-full w-full">
      {bubbles.map((b, i) => (
        <span
          key={i}
          className={`animate-bob absolute grid place-items-center rounded-full text-center font-bold leading-none ${
            b.c === "gold"
              ? "bg-gradient-to-br from-gold to-amber text-[#2a1800] shadow-[0_10px_30px_-10px_rgba(251,191,36,0.8)]"
              : "bg-gradient-to-br from-sky/90 to-azure text-white shadow-[0_10px_30px_-10px_rgba(2,132,199,0.9)]"
          }`}
          style={{
            left: `${b.x}%`,
            top: `${b.y}%`,
            width: `${b.r * 2}%`,
            aspectRatio: "1",
            translate: "-50% -50%",
            animationDelay: `${-i * 0.7}s`,
            fontSize: b.r > 10 ? 10.5 : 9,
          }}
        >
          {b.label}
        </span>
      ))}
    </div>
  );
}

/* ------------------------------------------------------------------ */
/* Hero                                                                */
/* ------------------------------------------------------------------ */

const railExtras = [Icon.Truck, Icon.Tank, Icon.Calendar, Icon.Receipt];

export function Hero() {
  const [index, setIndex] = useState(0);
  const [paused, setPaused] = useState(false);
  const [tab, setTab] = useState(0);
  const [clock, setClock] = useState("--:--");
  const [mounted, setMounted] = useState(false);
  const reduced = useRef(false);
  const s = scenes[index];

  useEffect(() => {
    reduced.current = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced.current) setPaused(true);
    requestAnimationFrame(() => setMounted(true));
    const tick = () =>
      setClock(
        new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Africa/Lagos" }).format(new Date())
      );
    tick();
    const id = setInterval(tick, 15000);
    return () => clearInterval(id);
  }, []);

  const go = (i: number) => {
    setIndex((i + scenes.length) % scenes.length);
    setTab(0);
  };
  const onCycleEnd = () => {
    if (reduced.current || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    go(index + 1);
  };

  return (
    <section id="top" className="relative isolate overflow-hidden" aria-roledescription="carousel" aria-label="PetroLedger live operations">
      {/* ---------- Background slideshow ---------- */}
      <div className="absolute inset-0 -z-10 bg-ink">
        {scenes.map((sc, i) => (
          <div
            key={sc.key}
            className={`absolute inset-0 transition-opacity duration-[1400ms] ease-out ${i === index ? "opacity-100" : "opacity-0"}`}
            aria-hidden={i !== index}
          >
            <Image
              src={sc.image}
              alt={sc.alt}
              fill
              preload={i === 0}
              sizes="100vw"
              className={`object-cover ${sc.position} transition-transform duration-[11000ms] ease-out ${
                mounted && i === index ? "scale-100" : "scale-[1.12]"
              }`}
            />
          </div>
        ))}
        <div className="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/35 to-ink/70" />
        <div className="absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-ink/60" />
        <div className="absolute -bottom-40 left-1/3 h-[520px] w-[820px] rounded-full bg-amber/25 blur-[140px]" />
        <div className="absolute -left-40 top-1/4 h-[480px] w-[480px] rounded-full bg-azure/25 blur-[130px]" />
        <div className="noise absolute inset-0" />
      </div>

      <div className="mx-auto max-w-[1440px] px-3 pb-10 pt-24 sm:px-5 lg:pt-28">
        <div className="grid gap-3 xl:grid-cols-[68px_minmax(0,1fr)]">
          {/* ---------- Left rail ---------- */}
          <aside className="glass hidden flex-col items-center justify-between rounded-[26px] py-4 xl:flex">
            <div className="flex flex-col items-center gap-2">
              {scenes.map((sc, i) => {
                const RI = sc.railIcon;
                const on = i === index;
                return (
                  <button
                    key={sc.key}
                    type="button"
                    onClick={() => go(i)}
                    aria-label={`Show ${sc.module}`}
                    aria-current={on}
                    className={`group relative grid h-12 w-12 place-items-center rounded-2xl transition ${
                      on ? "bg-gradient-to-b from-gold to-amber text-[#2a1800] shadow-[0_8px_24px_-8px_rgba(251,191,36,0.9)]" : "text-white/75 hover:bg-white/10"
                    }`}
                  >
                    <RI size={21} />
                    <span className="pointer-events-none absolute left-[calc(100%+12px)] top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-ink/90 px-2.5 py-1 text-[11.5px] font-semibold text-white opacity-0 ring-1 ring-white/10 transition group-hover:opacity-100">
                      {sc.module}
                    </span>
                  </button>
                );
              })}
              <span className="my-2 h-px w-8 bg-white/15" />
              {railExtras.map((RI, i) => (
                <a key={i} href="#modules" aria-label="Explore modules" className="grid h-12 w-12 place-items-center rounded-2xl text-white/60 transition hover:bg-white/10 hover:text-white">
                  <RI size={20} />
                </a>
              ))}
            </div>
            <div className="flex flex-col items-center gap-3">
              <button
                type="button"
                onClick={() => setPaused((p) => !p)}
                aria-label={paused ? "Play slideshow" : "Pause slideshow"}
                className="grid h-11 w-11 place-items-center rounded-full bg-white/10 text-white ring-1 ring-white/15 transition hover:bg-white/20"
              >
                {paused ? <Icon.Play size={16} /> : <Icon.Pause size={16} />}
              </button>
              <span className="grid h-11 w-11 place-items-center rounded-2xl bg-gradient-to-br from-azure to-navy-2 text-[13px] font-extrabold text-white ring-2 ring-gold/70">
                AO
              </span>
            </div>
          </aside>

          {/* ---------- Main canvas ---------- */}
          <div className="min-w-0">
            <div className="grid gap-3 lg:grid-cols-2 xl:grid-cols-[minmax(0,380px)_minmax(0,1fr)_minmax(0,400px)] xl:grid-rows-[auto_1fr]">
              {/* Assistant + recommendation */}
              <div className="order-3 flex flex-col gap-3 xl:order-none">
                <div className="glass flex items-center gap-3 rounded-[22px] p-3 pr-4">
                  <span className="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-gradient-to-b from-gold to-amber text-[#2a1800]">
                    <Icon.Sparkle size={22} />
                  </span>
                  <div className="min-w-0">
                    <p className="text-[16px] font-bold tracking-tight text-white">AI Operations Assistant</p>
                    <p key={s.key} className="fade-in truncate text-[12px] text-white/60">
                      {s.watching}
                    </p>
                  </div>
                  <span className="ml-auto inline-flex items-center gap-1.5 rounded-full bg-black/20 px-2.5 py-1 text-[10.5px] font-bold text-emerald-300">
                    <span className="pulse-dot h-1.5 w-1.5 rounded-full bg-emerald-400 text-emerald-400" /> Live
                  </span>
                </div>

                <div className="glass-amber relative min-h-[340px] flex-1 overflow-hidden rounded-[26px] p-4 shadow-[0_40px_80px_-30px_rgba(245,158,11,0.55)]">
                  <div key={`sch-${s.key}`} className="fade-in pointer-events-none absolute -right-2 top-2 h-[200px] w-[270px] opacity-80">
                    <Schematic kind={s.schematic} />
                  </div>
                  <div className="relative flex w-12 flex-col gap-2">
                    {[Icon.Mic, Icon.Monitor, Icon.Help].map((I, i) => (
                      <span key={i} className="grid h-12 w-12 place-items-center rounded-2xl bg-white/15 text-white ring-1 ring-white/20 backdrop-blur">
                        <I size={20} />
                      </span>
                    ))}
                  </div>
                  <div className="relative mt-8">
                    <p className="text-[22px] font-bold tracking-tight text-white">Primary recommendation</p>
                    <p key={`rec-${s.key}`} className="mt-2.5 text-[14.5px] font-medium leading-relaxed text-white/95">
                      {s.rec.split(" ").map((w, i) => (
                        <span key={i} className="rise inline-block" style={{ animationDelay: `${0.15 + i * 0.022}s` }}>
                          {w}&nbsp;
                        </span>
                      ))}
                    </p>
                    <div className="mt-4 flex flex-wrap gap-2">
                      <a href="#modules" className="rounded-xl bg-white px-3.5 py-2.5 text-[12.5px] font-bold text-navy shadow-lg transition hover:bg-canvas">
                        {s.actions[0]}
                      </a>
                      <a href="#modules" className="rounded-xl bg-black/20 px-3.5 py-2.5 text-[12.5px] font-semibold text-white ring-1 ring-white/25 transition hover:bg-black/30">
                        {s.actions[1]}
                      </a>
                    </div>
                  </div>
                </div>
              </div>

              {/* Chips */}
              <div className="order-2 flex flex-wrap items-start gap-2 lg:col-span-2 xl:order-none xl:col-span-1 xl:content-start xl:justify-center">
                <Chip className="min-w-0">
                  <Icon.Pin size={17} />
                  <span className="text-white/50 xl:hidden">Coordinates</span>
                  <span className="h-4 w-px bg-white/30 xl:hidden" />
                  <span key={s.coords} className="fade-in font-semibold">
                    {s.coords}
                  </span>
                </Chip>
                <Chip>
                  <Icon.Cloud size={18} />
                  <span key={s.weather} className="fade-in">
                    {s.weather}
                  </span>
                </Chip>
                <Chip>
                  <Icon.Wind size={18} />
                  <span key={s.wind} className="fade-in">
                    {s.wind}
                  </span>
                </Chip>
              </div>

              {/* Right column: live status + exceptions */}
              <div className="order-4 flex flex-col gap-3 xl:order-none xl:row-span-2 xl:self-start">
                <div className="glass rounded-[26px] p-3">
                  <div className="px-1.5 pt-1">
                    <CardHeader title="Live Status" />
                  </div>
                  <div className="mt-3 grid grid-cols-2 gap-2.5">
                    {s.tiles.map((t, i) => (
                      <TileCard key={`${s.key}-${i}`} tile={t} sceneKey={s.key} index={i} />
                    ))}
                  </div>
                </div>

                <div className="glass rounded-[26px] p-3">
                  <div className="px-1.5 pt-1">
                    <CardHeader title={s.exceptionsTitle} />
                  </div>
                  <div className="mt-3 space-y-2">
                    {s.exceptions.map((e, i) => {
                      const EI = e.icon;
                      return (
                        <div
                          key={`${s.key}-${i}`}
                          className="glass-tile rise flex gap-3 rounded-[18px] p-2.5"
                          style={{ animationDelay: `${0.12 + i * 0.1}s` }}
                        >
                          <span className="grid h-[68px] w-[68px] shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-white/90 to-white/60 text-navy">
                            <EI size={30} />
                          </span>
                          <div className="min-w-0 flex-1">
                            <div className="flex items-center justify-between gap-2">
                              <p className="truncate text-[14px] font-bold text-white">{e.name}</p>
                              <span className={`shrink-0 rounded-full px-2 py-0.5 text-[10px] font-bold ${toneBg[e.status.tone]}`}>
                                {e.status.text}
                              </span>
                            </div>
                            <p className="truncate text-[12px] text-white/55">{e.sub}</p>
                            <div className="mt-1 flex items-end justify-between gap-2">
                              <p className="truncate text-[11.5px] text-white/75">{e.action}</p>
                              <p className="shrink-0 text-[15px] font-extrabold leading-none text-white">{e.metric}</p>
                            </div>
                            <div className="mt-1.5 h-1.5 overflow-hidden rounded-full bg-black/30">
                              <div
                                className={`bar-anim-x h-full rounded-full bg-gradient-to-r ${toneBar[e.status.tone]}`}
                                style={{ width: `${e.fill * 100}%`, animationDelay: `${0.3 + i * 0.1}s` }}
                              />
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>

              {/* Headline block */}
              <div className="order-1 flex flex-col justify-end pb-1 pt-4 lg:col-span-2 xl:order-none xl:pt-6">
                {/* Scene tabs with progress */}
                <div className="grid max-w-lg grid-cols-3 gap-2" role="tablist" aria-label="Scenes">
                  {scenes.map((sc, i) => (
                    <button
                      key={sc.key}
                      type="button"
                      role="tab"
                      aria-selected={i === index}
                      onClick={() => go(i)}
                      className="group text-left"
                    >
                      <span className={`block truncate text-[10.5px] font-bold uppercase tracking-[0.1em] transition sm:text-[11px] sm:tracking-[0.14em] ${i === index ? "text-white" : "text-white/45 group-hover:text-white/80"}`}>
                        <span className={`hidden sm:inline ${i === index ? "text-gold" : ""}`}>0{i + 1} · </span>
                        {sc.module}
                      </span>
                      <span className="mt-2 block h-[3px] overflow-hidden rounded-full bg-white/20">
                        {i === index ? (
                          <span
                            key={`p-${index}`}
                            onAnimationEnd={onCycleEnd}
                            className="block h-full origin-left rounded-full bg-gold shadow-[0_0_10px_#fbbf24]"
                            style={{
                              animation: `progress ${DURATION}ms linear forwards`,
                              animationPlayState: paused ? "paused" : "running",
                            }}
                          />
                        ) : (
                          <span className={`block h-full rounded-full ${i < index ? "bg-white/60" : ""}`} />
                        )}
                      </span>
                    </button>
                  ))}
                </div>

                <h1 className="mt-6 max-w-[16ch] text-[2.7rem] font-extrabold leading-[0.98] tracking-[-0.04em] text-white sm:text-6xl xl:text-[4.1rem] 2xl:text-[4.6rem]">
                  Every litre, every line, <span className="text-gradient">on record.</span>
                </h1>

                <p className="mt-5 max-w-[62ch] text-[15.5px] leading-relaxed text-white/75 sm:text-[16.5px]">
                  One operating system for Nigerian energy service contractors: bunkering and e-BDN, pipeline integrity, depots,
                  bulk haulage, NCDMB local content and HSE permits. It works offline, and every action is on the audit trail.
                </p>

                <div className="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[13.5px] text-white/70">
                  <span className="inline-flex items-center gap-1.5">
                    <Icon.Clock size={17} /> <span className="font-semibold text-white">{clock} WAT</span>
                  </span>
                  <span className="h-4 w-px bg-white/30" />
                  <span key={s.scene} className="fade-in">
                    <span className="font-semibold text-white">{s.scene}</span> · {s.place}
                  </span>
                </div>

                <div className="mt-7 flex flex-col gap-3 sm:flex-row">
                  <a href="#contact" className="btn-amber inline-flex items-center justify-center gap-2 rounded-2xl px-6 py-4 text-[15px] font-bold">
                    Start a 60-day pilot <Icon.Arrow size={18} />
                  </a>
                  <a href="#modules" className="btn-ghost inline-flex items-center justify-center gap-2 rounded-2xl px-6 py-4 text-[15px] font-semibold text-white">
                    Explore the 12 modules
                  </a>
                </div>
              </div>
            </div>

            {/* ---------- Bottom row ---------- */}
            <div className="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
              <div className="glass overflow-hidden rounded-[26px] p-3">
                <div className="px-1.5 pt-1">
                  <CardHeader title="Operations map" href="#corridor" />
                </div>
                <div className="relative mt-3 h-[230px] overflow-hidden rounded-[20px] bg-gradient-to-b from-white/10 to-white/[0.03] ring-1 ring-white/10">
                  <CoastMap active={s.site} />
                  <span className="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-black/30 px-2.5 py-1 text-[10.5px] font-semibold text-gold">
                    <span className="h-1.5 w-1.5 rounded-full bg-gold" /> Online 7/7
                  </span>
                  <div className="absolute bottom-3 left-3 space-y-1 text-[10px] font-medium text-white/80">
                    {[
                      ["bg-gold", "Normal"],
                      ["bg-amber", "Warning"],
                      ["bg-red-500", "Critical"],
                    ].map(([c, l]) => (
                      <p key={l} className="flex items-center gap-1.5">
                        <span className={`h-2.5 w-[3px] rounded-full ${c}`} /> {l}
                      </p>
                    ))}
                  </div>
                </div>
              </div>

              <div className="glass overflow-hidden rounded-[26px] p-3">
                <div className="px-1.5 pt-1">
                  <CardHeader title={s.trend.title} />
                </div>
                <div className="mt-2 flex flex-wrap items-center gap-x-6 gap-y-1 px-1.5 text-[12px]">
                  <span className="inline-flex items-center gap-1.5 text-white/60">
                    <span className="h-1.5 w-1.5 rounded-full bg-gold" /> Updated 3 min ago
                  </span>
                  <span className="text-white/50">{s.trend.label}</span>
                </div>
                <div className="mt-2 flex items-end justify-between gap-3 px-1.5">
                  <p className="text-[34px] font-extrabold leading-none tracking-tight text-white">
                    <CountUp key={`${s.key}-${tab}`} to={s.trend.value * (1 - tab * 0.07)} decimals={s.trend.decimals ?? 0} />
                    <span className="ml-1.5 text-[14px] font-semibold text-white/45">{s.trend.unit}</span>
                  </p>
                  <div className="flex gap-3 text-[12.5px] font-semibold">
                    {s.trend.tabs.map((t, i) => (
                      <button
                        key={t}
                        type="button"
                        onClick={() => setTab(i)}
                        className={`border-b-2 pb-0.5 transition ${i === tab ? "border-gold text-white" : "border-transparent text-white/45 hover:text-white/80"}`}
                      >
                        {t}
                      </button>
                    ))}
                  </div>
                </div>
                <div className="mt-4 h-[150px] px-1.5">
                  <TrendBars seed={s.trend.seed} tab={tab} />
                </div>
              </div>

              <div className="glass relative overflow-hidden rounded-[26px] p-3 md:col-span-2 xl:col-span-1">
                <div className="absolute inset-0 -z-10 bg-gradient-to-br from-transparent via-transparent to-amber/20" />
                <div className="px-1.5 pt-1">
                  <CardHeader title="Compliance Shield" href="#compliance" />
                </div>
                <p className="mt-2 inline-flex items-center gap-1.5 px-1.5 text-[12px] text-white/60">
                  <span className="h-1.5 w-1.5 rounded-full bg-gold" /> Renewals in the next 90 days ·{" "}
                  <span className="font-semibold text-white">NCFCC due in 23 days</span>
                </p>
                <div className="mt-2 h-[214px]">
                  <RenewalBubbles />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
