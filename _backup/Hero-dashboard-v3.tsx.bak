"use client";

import Image from "next/image";
import { useEffect, useMemo, useRef, useState, type ComponentType, type ReactNode } from "react";
import { Icon } from "./icons";
import { seeded } from "./charts";
import { CountUp } from "./primitives";

/* ------------------------------------------------------------------ */
/* Scene data                                                          */
/* ------------------------------------------------------------------ */

type IconC = ComponentType<{ size?: number; className?: string }>;
type Tone = "ok" | "warn" | "crit" | "info";

type Tile =
  | {
      kind: "spark";
      label: string;
      icon: IconC;
      value: number;
      decimals?: number;
      prefix?: string;
      unit?: string;
      note: string;
      tone: Tone;
      seed: number;
      color?: string;
    }
  | { kind: "progress"; label: string; icon: IconC; display: string; note: string; pct: number }
  | { kind: "bars"; label: string; icon: IconC; display: string; note: string; seed: number };

type Exception = {
  icon: IconC;
  name: string;
  status: { text: string; tone: Tone };
  sub: string;
  action: string;
  metric: string;
  fill: number;
};

type Scene = {
  key: string;
  module: string;
  railIcon: IconC;
  image: string;
  alt: string;
  position: string;
  scene: string;
  place: string;
  coords: string;
  weather: string;
  wind: string;
  watching: string;
  schematic: "bunker" | "pig" | "permit";
  rec: string;
  actions: [string, string];
  tiles: [Tile, Tile, Tile, Tile];
  exceptionsTitle: string;
  exceptions: Exception[];
  site: string;
  trend: { title: string; label: string; value: number; decimals?: number; unit: string; tabs: [string, string, string]; seed: number };
};

