  ["14:10", "Gantry ticket #88213 · Δ 0.06%", "0b7e4dc9"],
];

const toneCls: Record<Tone, { badge: string; icon: string; Icon: IconC }> = {
  ok: { badge: "bg-emerald-50 text-emerald-800 border-emerald-200", icon: "text-emerald-700 bg-emerald-50", Icon: Icon.Check },
  warn: { badge: "bg-amber-50 text-amber-800 border-amber-200", icon: "text-amber-700 bg-amber-50", Icon: Icon.Alert },
  crit: { badge: "bg-rose-50 text-rose-800 border-rose-200", icon: "text-rose-700 bg-rose-50", Icon: Icon.Alert },
};

/* ------------------------------------------------------------------ */
/* Pieces                                                              */
/* ------------------------------------------------------------------ */

function Spark({ seed, id }: { seed: number; id: string }) {
  const data = seeded(18, seed, 0.15, 0.95);
  const w = 200;
  const h = 48;
  const d = data.map((v, i) => `${i ? "L" : "M"}${((i / (data.length - 1)) * w).toFixed(1)},${(h - v * (h - 6) - 3).toFixed(1)}`).join(" ");
  return (
    <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" className="h-full w-full" aria-hidden>
      <defs>
        <linearGradient id={`hsp-${id}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stopColor="#10b981" stopOpacity="0.22" />
          <stop offset="1" stopColor="#10b981" stopOpacity="0" />
        </linearGradient>
      </defs>
      <path d={`${d} L${w},${h} L0,${h} Z`} fill={`url(#hsp-${id})`} className="fade-in" style={{ animationDelay: "0.4s" }} />
      <path d={d} pathLength={1} fill="none" stroke="#059669" strokeWidth="2.2" vectorEffect="non-scaling-stroke" strokeLinejoin="round" className="draw-line" />
    </svg>
  );
}

/** The clean live record card built step-by-step. */
function RecordCard({ c, step }: { c: Chapter; step: number }) {
  const done = step >= c.steps.length;
  const pct = Math.min(1, step / c.steps.length);

  return (
    <div className="relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-6 shadow-[0_20px_50px_-20px_rgba(15,23,42,0.1)]">
      {/* Top Header */}
      <div className="flex items-center justify-between gap-3 border-b border-slate-100 pb-4">
        <div>
          <div className="flex items-center gap-2">
            <span className="font-mono text-[11px] font-semibold text-slate-500 uppercase">{c.record.id}</span>
            <span className="text-slate-300">·</span>
            <span className="text-[11px] font-semibold text-emerald-800">{c.module}</span>
          </div>
          <p className="mt-0.5 truncate text-[15px] font-bold text-slate-900">{c.record.title}</p>
        </div>
        <span
          className={`inline-flex shrink-0 items-center gap-1.5 rounded-lg border px-2.5 py-1 text-[11.5px] font-semibold transition-colors duration-300 ${
            done
              ? "border-emerald-200 bg-emerald-50 text-emerald-800"
              : "border-slate-200 bg-slate-50 text-slate-700"
          }`}
        >
          <span className={`h-1.5 w-1.5 rounded-full ${done ? "bg-emerald-600" : "bg-emerald-500 animate-pulse"}`} />
          {done ? "Verified" : "Recording"}
        </span>
      </div>

      {/* Progress track */}
      <div className="relative mt-5">
        <div className="absolute bottom-2.5 left-[11px] top-2.5 w-[2px] bg-slate-100">
          <div
            className="w-full bg-emerald-600 transition-[height] duration-700 ease-out"
            style={{ height: `${pct * 100}%` }}
          />
        </div>

        <ul className="space-y-3.5">
          {c.steps.map((s, i) => {
            const state = i < step ? "done" : i === step ? "active" : "todo";
            return (
              <li key={s.label} className="relative flex items-center gap-3.5">
                <span
                  className={`relative z-10 grid h-6 w-6 shrink-0 place-items-center rounded-md text-[11px] font-bold transition-all duration-300 ${
                    state === "done"
                      ? s.flag
                        ? "border border-amber-300 bg-amber-50 text-amber-800"
                        : "bg-emerald-600 text-white"
                      : state === "active"
                        ? "border border-emerald-600 bg-white text-emerald-700 ring-2 ring-emerald-100"
                        : "border border-slate-200 bg-slate-50 text-slate-300"
                  }`}
                >
                  {state === "done" && (s.flag ? "!" : "✓")}
                  {state === "active" && "•"}
                </span>

                <span
                  className={`flex-1 truncate text-[13.5px] transition-colors duration-300 ${
                    state === "todo" ? "text-slate-400" : "font-medium text-slate-800"
                  }`}
                >
                  {s.label}
                </span>

                <span
                  className={`shrink-0 font-mono text-[11px] transition-opacity duration-300 ${
                    state === "done" ? "opacity-100" : "opacity-0"
                  } ${s.flag ? "font-semibold text-amber-700" : "text-slate-500"}`}
                >
                  {s.meta}
                </span>
              </li>
            );
          })}
        </ul>
      </div>

      {/* Footer: Seal confirmation */}
      <div className="mt-5 flex h-13 items-center justify-between rounded-xl border border-slate-200/80 bg-slate-50/90 px-3.5">
        {done ? (
          <>
            <div className="flex items-center gap-2.5">
              <span className="grid h-7 w-7 place-items-center rounded-lg bg-emerald-600 text-white text-[12px] font-bold">
                ✓
              </span>
              <div>
                <p className="text-[12px] font-bold text-slate-900 leading-tight">Ledger Sealed</p>
                <p className="font-mono text-[10px] text-slate-500">sha256 · 3fa9c2e1…51ce90f2</p>
              </div>
            </div>
            <span className="text-[11px] font-semibold text-emerald-800">Immutable</span>
          </>
        ) : (
          <div className="w-full">
            <div className="flex justify-between text-[11.5px] font-medium text-slate-600 mb-1.5">
              <span>Streaming verification…</span>
              <span className="font-mono font-semibold text-emerald-700">{Math.round(pct * 100)}%</span>
            </div>
            <div className="h-1.5 overflow-hidden rounded-full bg-slate-200">
              <div
                className="h-full rounded-full bg-emerald-600 transition-[width] duration-700"
                style={{ width: `${pct * 100}%` }}
              />
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

/* ------------------------------------------------------------------ */
/* Hero Main                                                          */
/* ------------------------------------------------------------------ */

export function Hero() {
  const [index, setIndex] = useState(0);
  const [step, setStep] = useState(0);
  const [paused, setPaused] = useState(false);
  const sectionRef = useRef<HTMLElement>(null);
  const reduced = useRef(false);
  const c = chapters[index];

  useEffect(() => {
    reduced.current = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced.current) setPaused(true);
  }, []);

  // Step through the record for the active chapter
  useEffect(() => {
    if (reduced.current) {
      setStep(chapters[index].steps.length);
      return;
    }
    setStep(0);
    const id = setInterval(() => {
      setStep((s) => (s >= chapters[index].steps.length ? s : s + 1));
    }, STEP_MS);
    return () => clearInterval(id);
  }, [index]);

  const go = (i: number) => {
    const next = (i + chapters.length) % chapters.length;
    if (next === index) return;
    setIndex(next);
  };

  const onCycleEnd = () => {
    if (reduced.current || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    go(index + 1);
  };

  const T = toneCls[c.toast.tone];
  const ToastIcon = T.Icon;

  return (
    <section
      ref={sectionRef}
      id="top"
      className="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-white"
      aria-label="PetroLedger Energy OS"
    >
      {/* Background decoration: clean, modern light pattern */}
      <div className="absolute inset-0 -z-10 bg-white">
        <div className="grid-bg absolute inset-0 opacity-60" />
        <div className="absolute -left-32 top-10 h-[520px] w-[520px] rounded-full bg-emerald-50/80 blur-[130px]" />
        <div className="absolute -bottom-20 right-0 h-[500px] w-[620px] rounded-full bg-slate-100/80 blur-[140px]" />
      </div>

      {/* Main Container */}
      <div className="mx-auto grid w-full max-w-[1360px] flex-1 content-center items-center gap-12 px-5 pb-10 pt-32 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pt-36">
        {/* Editorial Headline Column */}
        <div className="max-w-[620px]">
          {/* Eyebrow */}
          <div className="inline-flex items-center gap-2 rounded-lg border border-emerald-200/90 bg-emerald-50/80 px-3 py-1 text-[11.5px] font-bold uppercase tracking-[0.16em] text-emerald-800">
            <span className="h-1.5 w-1.5 rounded-sm bg-emerald-600" />
            Energy OS for Nigerian Contractors
          </div>

          {/* Headline in Outfit */}
          <h1 className="mt-6 text-[2.85rem] font-extrabold leading-[1.04] tracking-[-0.04em] text-slate-900 sm:text-[3.75rem] xl:text-[4.35rem]">
            Every{" "}
            <span className="relative inline-grid h-[1.08em] overflow-hidden align-bottom">
              {chapters.map((ch, i) => (
                <span
                  key={ch.key}
                  aria-hidden={i !== index}
                  className="col-start-1 row-start-1 text-gradient-emerald transition-all duration-700 ease-[cubic-bezier(0.7,0,0.2,1)]"
                  style={{
                    transform: `translateY(${(i - index) * 110}%)`,
                    opacity: i === index ? 1 : 0,
                    filter: i === index ? "none" : "blur(4px)",
                  }}
                >
                  {ch.word},
                </span>
              ))}
            </span>
            <br />
            on record.
          </h1>

          <p key={c.key} className="mt-6 max-w-[50ch] text-[16px] leading-relaxed text-slate-600 sm:text-[17px]">
            {c.line}
          </p>

          {/* Primary Action Buttons */}
          <div className="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="#contact"
              className="btn-green inline-flex items-center justify-center gap-2 rounded-xl px-7 py-3.5 text-[14.5px] font-semibold text-white"
            >
              Start a 60-day pilot <Icon.Arrow size={16} />
            </a>
            <a
              href="#modules"
              className="btn-ghost inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-[14.5px] font-medium text-slate-800"
            >
              Explore all 12 modules <Icon.Chevron size={15} className="text-slate-400" />
            </a>
          </div>

          {/* Clean trust attributes */}
          <div className="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-[13px] text-slate-600">
            <span className="inline-flex items-center gap-2">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-600" /> Works 100% offline
            </span>
            <span className="inline-flex items-center gap-2">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-600" /> Tamper-evident ledger
            </span>
            <span className="inline-flex items-center gap-2">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-600" /> NCDMB audit-ready
            </span>
          </div>
        </div>

        {/* Product Preview Pane */}
        <div className="relative mx-auto w-full max-w-[480px] lg:mx-0">
          {/* Real Photo Thumbnail Header */}
          <div className="relative mb-3.5 aspect-[16/7.5] w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm">
            <Image
              src={c.image}
              alt={c.alt}
              fill
              sizes="(max-width: 768px) 100vw, 480px"
              className={`object-cover ${c.position} transition-all duration-700`}
            />
            <div className="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/20 to-transparent" />
            <div className="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white text-[12px]">
              <span className="font-semibold flex items-center gap-1.5">
                <Icon.Pin size={13} className="text-emerald-400" /> {c.place}
              </span>
              <span className="font-mono text-[10.5px] opacity-80">{c.coords}</span>
            </div>
          </div>

          {/* Interactive Record Card */}
          <div key={c.key} className="rise">
            <RecordCard c={c} step={step} />
          </div>

          {/* Metric KPI Card */}
          <div className="mt-3.5 flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div>
              <p className="text-[11.5px] font-medium text-slate-500">{c.metric.label}</p>
              <p className="mt-0.5 text-[24px] font-extrabold leading-none text-slate-950">
                <CountUp key={c.key} to={c.metric.value} decimals={c.metric.decimals ?? 0} />
                <span className="ml-1 text-[12px] font-semibold text-slate-400">{c.metric.unit}</span>
              </p>
              <p className="mt-1 text-[11px] font-bold text-emerald-700">{c.metric.note}</p>
            </div>
            <div className="h-11 w-32 shrink-0">
              <Spark seed={c.metric.seed} id={c.key} />
            </div>
          </div>

          {/* Toast Notification */}
          {step >= 2 && (
            <div key={c.key} className="toast-in mt-3 flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-md">
              <span className={`grid h-7 w-7 shrink-0 place-items-center rounded-lg ${T.icon}`}>
                <ToastIcon size={14} />
              </span>
              <div className="min-w-0">
                <p className="truncate text-[12px] font-bold text-slate-900">{c.toast.title}</p>
                <p className="truncate text-[11px] text-slate-500">{c.toast.text}</p>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Chapter Tabs */}
      <div className="mx-auto w-full max-w-[1360px] px-5 pb-6 sm:px-8">
        <div className="flex items-stretch gap-2">
          <div className="no-scrollbar grid flex-1 auto-cols-[minmax(220px,1fr)] grid-flow-col gap-2 overflow-x-auto" role="tablist" aria-label="Operational chapters">
            {chapters.map((ch, i) => {
              const on = i === index;
              return (
                <button
                  key={ch.key}
                  type="button"
                  role="tab"
                  aria-selected={on}
                  onClick={() => go(i)}
                  className={`group relative overflow-hidden rounded-xl p-3.5 text-left transition duration-300 ${
                    on
                      ? "border border-slate-300 bg-white shadow-sm"
                      : "border border-slate-200/80 bg-slate-50/70 hover:bg-slate-100/70 hover:border-slate-300"
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <p className={`text-[13.5px] font-bold transition ${on ? "text-slate-900" : "text-slate-600"}`}>
                      <span className="mr-1.5 font-mono text-[11px] text-emerald-700">0{i + 1}</span>
                      {ch.module}
                    </p>
                    <span className="text-[11px] font-medium text-slate-400 capitalize">{ch.word}</span>
                  </div>
                  <p className="mt-1 truncate text-[11.5px] text-slate-500">Every {ch.word}, on record</p>
                  
                  {/* Progress line */}
                  <span className="absolute inset-x-0 bottom-0 h-[2.5px] bg-slate-200">
                    {on && (
                      <span
                        key={`p-${index}`}
                        onAnimationEnd={onCycleEnd}
                        className="block h-full origin-left bg-emerald-600"
                        style={{
                          animation: `progress ${DURATION}ms linear forwards`,
                          animationPlayState: paused ? "paused" : "running",
                        }}
                      />
                    )}
                  </span>
                </button>
              );
            })}
          </div>

          <button
            type="button"
            onClick={() => setPaused((p) => !p)}
            aria-label={paused ? "Play slideshow" : "Pause slideshow"}
            className="hidden w-11 shrink-0 place-items-center rounded-xl border border-slate-200 bg-white text-slate-700 transition hover:bg-slate-50 sm:grid"
          >
            {paused ? <Icon.Play size={14} /> : <Icon.Pause size={14} />}
          </button>
        </div>
      </div>

      {/* Live ledger ticker */}
      <div className="relative flex items-center border-t border-slate-200 bg-slate-50/80 py-3 backdrop-blur-md">
        <div className="flex shrink-0 items-center gap-2 pl-5 pr-4 text-[11px] font-bold uppercase tracking-[0.16em] text-emerald-800 sm:pl-8">
          <span className="h-2 w-2 rounded-full bg-emerald-500 animate-pulse" /> Live ledger
        </div>
        <div className="min-w-0 flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_6%,#000_94%,transparent)]">
          <div className="animate-marquee flex w-max gap-10">
            {[...ticker, ...ticker].map(([t, what, sig], i) => (
              <span key={i} className="inline-flex items-center gap-2.5 whitespace-nowrap text-[12.5px]">
                <span className="font-mono text-slate-400">{t}</span>
                <span className="font-medium text-slate-800">{what}</span>
                <span className="font-mono text-[11px] text-emerald-700">sig {sig}</span>
                <span className="text-slate-300">·</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  );
}
